{
  "name": "dsh-reload-buttons",
  "version": "0.1.5",
  "description": "在 DSH 界面左上角放两个按钮：刷新界面、重启应用。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src",
    "lib/client.js",
    "assets",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reload",
    "refresh",
    "restart",
    "ui"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "check": "node --check index.js && node --check assets/restart-app.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "author": "taoziliyouchong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-reload-buttons"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-reload-buttons#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-reload-buttons/issues"
  }
}
